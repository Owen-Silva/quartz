# release-signers -- the keys a Quartz release tag must be signed with (git's SSH "allowed signers"
# format: principal, options, key type, public key).
#
# The in-app updater (updater.js) reads THIS file from the copy that is already installed, before it
# fetches anything, and refuses a release whose tag is not signed by one of these keys. A release
# can therefore never vouch for itself: a new key only counts once a release signed by an old key
# has put it here (see tools/RELEASING.md, "Rotating the signing key").
#
# Public keys only. The private half never enters the repository.
quartz-release namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC2y1adAZMsZU1uDo3kU3CTnGhNUf1HrWLjwleLqgzYv
